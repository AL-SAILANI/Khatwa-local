# Firebase client SDK config — from Firebase Console > Project Settings > General
# These are public by design (safe to expose to the browser); access is
# actually enforced by firestore.rules / storage.rules, not by secrecy.
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=
NEXT_PUBLIC_FIREBASE_MEASUREMENT_ID=

# Web Push certificate key pair (Firebase Console > Project Settings >
# Cloud Messaging > Web configuration > "Generate key pair"). Without this,
# the notification toggle in Settings stays a no-op — no push is sent.
NEXT_PUBLIC_FIREBASE_VAPID_KEY=

# Server-only Firebase Admin SDK credentials (Firebase Console > Project
# Settings > Service Accounts > Generate new private key). Paste the whole
# JSON file contents as a single-line string. Not needed on Firebase App
# Hosting / Cloud Functions, where Application Default Credentials apply.
FIREBASE_SERVICE_ACCOUNT_KEY=

# Public site URL, used for metadata and OG tags.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Authorizes the daily streak-reminder cron (src/app/api/cron/streak-reminder,
# scheduled by vercel.json). Set this to any random string in your Vercel
# project's env vars — Vercel then automatically sends it as a Bearer token
# on every cron invocation, so the endpoint can verify the request came from
# Vercel's scheduler and not the public internet. Optional locally.
CRON_SECRET=

# Stripe (Dashboard > Developers > API keys / Webhooks / Products). Without
# these, the pricing page's "اشترك الآن" button shows a clear "not
# configured yet" error instead of crashing — free tier and everything else
# works the same either way.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_ID_PRO=
STRIPE_PRICE_ID_PREMIUM=
# Optional yearly billing Price IDs. When set, the pricing page's Monthly/
# Yearly toggle uses them; when unset it falls back to the monthly IDs above.
STRIPE_PRICE_ID_PRO_YEARLY=
STRIPE_PRICE_ID_PREMIUM_YEARLY=
